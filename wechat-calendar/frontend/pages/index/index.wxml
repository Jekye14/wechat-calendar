<!-- pages/index/index.wxml -->
<view class="page">
  <view class="header">
    <view class="header-left" bindtap="goProfile">
      <image class="avatar" src="{{userInfo.avatar_url || ''}}" mode="aspectFill"/>
      <text class="welcome">{{userInfo ? userInfo.nick_name : t.index.pleaseLogin}}</text>
    </view>
    <view class="header-btn header-btn-mid" bindtap="generateBindCode">{{t.index.generateBindCode}}</view>
    <view class="header-btn" bindtap="showCreate">{{t.index.newCalendarBtn}}</view>
  </view>

  <view class="section-title">{{t.index.myCalendars}}</view>

  <view wx:if="{{loading}}" class="empty">{{t.common.loading}}</view>
  <view wx:elif="{{calendars.length === 0}}" class="empty">{{t.index.noCalendars}}</view>

  <view wx:else class="cal-list">
    <view class="cal-card" wx:for="{{calendars}}" wx:key="id"
      bindtap="openCalendar" data-id="{{item.id}}">
      <view class="cal-icon" style="background:{{item.isCreator ? '#4A90D9' : '#7BC47F'}}">
        <text>{{item.name[0]}}</text>
      </view>
      <view class="cal-info">
        <view class="cal-name">{{item.name}}</view>
        <view class="cal-desc">{{item.description || t.common.noDescription}}</view>
        <view class="cal-meta">
          <text class="role-tag {{item.isCreator ? 'role-creator' : 'role-member'}}">
            {{item.isCreator ? t.index.creatorTag : t.index.memberTag}}
          </text>
          <text class="cal-date">{{item.created_at.substring(0,10)}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 新建弹窗 -->
  <view class="modal-mask" wx:if="{{showCreateModal}}" bindtap="closeCreate">
    <view class="modal" catchtap="noop">
      <view class="modal-title">{{t.index.newCalendarTitle}}</view>
      <view class="field">
        <text class="field-label">{{t.index.calendarName}}</text>
        <input class="field-input" placeholder="{{t.index.calendarNamePlaceholder}}" value="{{newName}}" bindinput="onNameInput"/>
      </view>
      <view class="field">
        <text class="field-label">{{t.index.calendarDesc}}</text>
        <textarea class="field-textarea" placeholder="{{t.index.calendarDescPlaceholder}}" value="{{newDesc}}" bindinput="onDescInput"/>
      </view>
      <view class="modal-btns">
        <view class="modal-btn cancel" bindtap="closeCreate">{{t.common.cancel}}</view>
        <view class="modal-btn confirm" bindtap="createCalendar">{{t.common.create}}</view>
      </view>
    </view>
  </view>
</view>
