<!-- pages/calendar/calendar.wxml  ── 周视图日历 -->
<view class="page">
  <!-- 顶部 Tab -->
  <view class="tab-row">
    <view class="tab {{activeTab=='calendar'?'tab-active':''}}" data-tab="calendar" bindtap="switchTab">{{t.calendar.tabCalendar}}</view>
    <view class="tab {{activeTab=='members'?'tab-active':''}}" data-tab="members" bindtap="switchTab">{{t.calendar.tabMembers}}</view>
  </view>

  <!-- 周视图 -->
  <view wx:if="{{activeTab=='calendar'}}" class="week-view">
    <!-- 导航行 -->
    <view class="week-nav">
      <text class="nav-arrow" bindtap="prevWeek">‹</text>
      <text class="nav-range">{{weekStart}} ~ {{weekDays[6].dateStr}}</text>
      <text class="nav-arrow" bindtap="nextWeek">›</text>
      <view class="nav-today" bindtap="goToday">{{t.calendar.today}}</view>
    </view>

    <!-- 星期标题 -->
    <view class="week-header">
      <view class="time-col"></view>
      <view class="day-col {{item.isToday?'today-col':''}}" wx:for="{{weekDays}}" wx:key="dateStr">
        <text class="day-label">{{item.label}}</text>
        <text class="day-num {{item.isToday?'today-num':''}}">{{item.dayNum}}</text>
      </view>
    </view>

    <!-- 事件区域 -->
    <scroll-view class="week-scroll" scroll-y enhanced show-scrollbar="false">
      <view class="week-body">
        <!-- 时间轴 -->
        <view class="time-axis">
          <view class="hour-marker" wx:for="{{hourLabels}}" wx:key="*this">
            <text class="hour-text">{{item}}</text>
          </view>
        </view>

        <!-- 网格 + 事件 -->
        <view class="grid-area">
          <!-- 网格线（7列） -->
          <view class="grid-col" wx:for="{{[0,1,2,3,4,5,6]}}" wx:key="*this"></view>

          <!-- 事件块 -->
          <view class="event-block {{item.status=='pending'?'ev-pending':''}} {{item.status=='update_pending'?'ev-pending':''}} {{item.status=='delete_pending'?'ev-pending':''}} {{item.event_type=='assigned'?'ev-assigned':''}}"
            wx:for="{{eventBlocks}}" wx:key="id"
            style="{{item.style}}"
            bindtap="openEvent" data-id="{{item.id}}">
            <text class="ev-time">{{item.startLabel}}-{{item.endLabel}}</text>
            <text class="ev-title">{{item.title}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 图例 -->
    <view class="legend">
      <view wx:for="{{members}}" wx:if="{{colorMap[item.id]}}" wx:key="id" class="legend-item">
        <view class="legend-dot" style="background:{{colorMap[item.id]}}"></view>
        <text class="legend-name">{{item.nick_name}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="fab-group" wx:if="{{isCreator}}">
      <view class="fab fab-primary" bindtap="goCreateEvent">{{t.calendar.createEvent}}</view>
      <view class="fab fab-secondary" bindtap="goCreateAssigned">{{t.calendar.assignEvent}}</view>
    </view>
    <view class="fab-group" wx:else>
      <view class="fab fab-primary" bindtap="goCreateEvent">{{t.calendar.createEvent}}</view>
    </view>
    <view class="invite-btn" bindtap="shareInvite">{{t.calendar.shareInvite}}</view>
  </view>

  <!-- 成员列表 -->
  <view wx:if="{{activeTab=='members'}}" class="members-view">
    <!-- 创建者区域 -->
    <view class="member-section">
      <text class="section-header">{{t.calendar.creatorSection}}</text>
      <view class="member-card">
        <image class="member-avatar" src="{{calendar ? calendar.creator_avatar_url : ''}}" mode="aspectFill" />
        <view class="member-info">
          <text class="member-name">{{calendar ? calendar.creator_name : t.calendar.creatorSection}}</text>
          <text class="member-role">{{t.calendar.calendarCreator}}</text>
        </view>
      </view>
    </view>

    <!-- 成员区域 -->
    <view class="member-section">
      <text class="section-header">{{t.calendar.membersSection.replace('{{count}}', members.length)}}</text>
      <view wx:if="{{members.length===0}}" class="empty">{{t.calendar.noMembers}}</view>
      <block wx:else>
        <view class="member-card" wx:for="{{members}}" wx:key="id">
          <image class="member-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
          <view class="member-info">
            <text class="member-name">{{item.nick_name}}</text>
            <text class="member-role">{{t.calendar.joinedOn}}{{item.joined_at.substring(0,10)}}</text>
          </view>
          <view wx:if="{{isCreator}}" class="member-remove" bindtap="removeMember" data-id="{{item.id}}" data-name="{{item.nick_name}}">{{t.calendar.removeMember}}</view>
        </view>
      </block>
    </view>

    <!-- 删除日历 -->
    <view wx:if="{{isCreator}}" class="delete-cal-btn" bindtap="deleteCalendar">{{t.calendar.deleteCalendar}}</view>
  </view>
</view>
