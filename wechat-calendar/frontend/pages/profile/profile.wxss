.container {
  padding: 32rpx;
  min-height: 100vh;
  background: #F5F5F5;
}

.profile-card {
  background: #FFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx 32rpx;
  margin-bottom: 40rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: #E8E8E8;
}

.avatar-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.nickname-section {
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.wechat-hint {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.save-section {
  padding: 0 32rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  color: #FFF;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn[disabled] {
  background: #A5E8C4;
}
