<!-- pages/notification/notification.wxml -->
<view class="page">
  <view class="nav-title">{{t.nav.notificationTitle}}</view>
  <view class="subscribe-card">
    <view class="subscribe-head">
      <view class="subscribe-title">{{t.notification.wechatSubscribe}}</view>
      <view class="subscribe-status {{subscribeStatusClass}}">{{subscribeStatusText}}</view>
    </view>
    <view class="subscribe-desc">{{t.notification.subscribeDesc}}</view>
    <button class="subscribe-btn" bindtap="requestSubscribe" loading="{{subscribeLoading}}">
      {{subscribeButtonText}}
    </button>
    <view class="sub-tip">{{t.notification.subscribeTip}}</view>
  </view>
  <view wx:if="{{loading}}" class="empty">{{t.common.loading}}</view>
  <view wx:elif="{{notifications.length===0}}" class="empty">
    <text>{{t.notification.noNotifications}}</text>
  </view>
  <view wx:else class="notif-list">
    <view
      class="notif-item {{item.is_read?'read':'unread'}}"
      wx:for="{{notifications}}" wx:key="id"
      bindtap="goToEvent"
      data-event-id="{{item.ref_event_id}}"
    >
      <view class="notif-icon type-{{item.type}}">
        <text wx:if="{{item.type=='new_event'}}">📋</text>
        <text wx:elif="{{item.type=='approved'}}">✅</text>
        <text wx:elif="{{item.type=='rejected'}}">❌</text>
        <text wx:elif="{{item.type=='assigned'}}">📌</text>
        <text wx:else>🔔</text>
      </view>
      <view class="notif-body">
        <view class="notif-title">{{item.title}}</view>
        <view class="notif-content">{{item.content}}</view>
        <view class="notif-time">{{item.created_at_text}}</view>
      </view>
      <view wx:if="{{!item.is_read}}" class="unread-dot"></view>
    </view>
  </view>
</view>
