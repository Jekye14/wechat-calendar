<!-- pages/assigned-event/assigned-event.wxml -->
<view class="page">
  <view class="form-card">
    <view class="field">
      <text class="label required">{{t.event.title}}</text>
      <input class="input" placeholder="{{t.event.titlePlaceholder}}" value="{{title}}" bindinput="onTitleInput"/>
    </view>
    <view class="divider"></view>
    <view class="field">
      <text class="label required">{{t.event.startTime}}</text>
      <view class="datetime-row">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="picker-box">{{startDate}}</view>
        </picker>
        <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="picker-box">{{startTime}}</view>
        </picker>
      </view>
    </view>
    <view class="divider"></view>
    <view class="field">
      <text class="label required">{{t.event.endTime}}</text>
      <view class="datetime-row">
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="picker-box">{{endDate}}</view>
        </picker>
        <picker mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
          <view class="picker-box">{{endTime}}</view>
        </picker>
      </view>
    </view>
    <view class="divider"></view>
    <view class="field">
      <text class="label">{{t.event.location}}</text>
      <input class="input" placeholder="{{t.event.locationPlaceholder}}" value="{{location}}" bindinput="onLocationInput"/>
    </view>
    <view class="divider"></view>
    <view class="field">
      <text class="label">{{t.event.content}}</text>
      <textarea class="textarea" placeholder="{{t.event.locationPlaceholder}}" value="{{content}}" bindinput="onContentInput"/>
    </view>
  </view>

  <!-- 选择成员 -->
  <view class="section-title">{{assignMembersText}}</view>
  <view class="member-card">
    <view wx:if="{{members.length===0}}" class="empty">{{t.event.noMembersInCalendar}}</view>
    <view wx:else>
      <view class="member-item" wx:for="{{members}}" wx:key="id"
        bindtap="toggleMember" data-index="{{index}}">
        <image class="member-avatar" src="{{item.avatar_url}}" mode="aspectFill"/>
        <text class="member-name">{{item.nick_name}}</text>
        <view class="check {{item.selected?'checked':''}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tip">{{t.event.assignNote}}</view>

  <view class="submit-btn {{submitting?'disabled':''}}" bindtap="submit">
    {{submitting ? t.event.submitting : t.event.submitAssignedEvent}}
  </view>
</view>
